# SmartHorizon Hackathon 2026 — Backend Environment Configuration Example

# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Database Connection (SQLite default for dev; replace with PostgreSQL URI for production)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Use a strong 64-character random hex string in production)
JWT_SECRET="smarthorizon_production_super_secret_jwt_key_2026_change_in_prod"

# Initial Admin Bootstrap Secret (Used only during initial deployment setup)
INITIAL_ADMIN_SECRET="SH26_BOOTSTRAP_ADMIN_KEY_CHANGE_ME"

# Node Environment ('development' | 'production')
NODE_ENV=development
